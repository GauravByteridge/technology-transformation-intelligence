{
  "services": {
    "backend": {
      "name": "Backend (FastAPI)",
      "tech": "Python / FastAPI / Uvicorn / SQLAlchemy",
      "directory": "../../backend",
      "port": 8000,
      "runCommand": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "debugPort": null,
      "watchPatterns": [
        "**/*.py"
      ]
    },
    "frontend": {
      "name": "Frontend (React/Vite)",
      "tech": "TypeScript / React 19 / Vite / TanStack Query",
      "directory": "../../frontend",
      "port": 5173,
      "runCommand": "npm run dev -- --host",
      "watchPatterns": ["src/**/*"]
    }
  },
  "databases": {
    "app_db": {
      "name": "App DB (PostgreSQL)",
      "host": "localhost",
      "port": 5432,
      "database": "app_db",
      "username": "postgres",
      "password": "master"
    },
    "rag_db": {
      "name": "RAG DB (PostgreSQL + pgvector)",
      "host": "localhost",
      "port": 5432,
      "database": "rag_db",
      "username": "postgres",
      "password": "master"
    }
  },
  "seeds": {
    "app_db": {
      "name": "Seed App DB",
      "description": "Run enterprise data seeds",
      "commands": [
        "python ../database/seed_enterprise_sources.py",
        "python ../database/seed_data_sources.py"
      ],
      "cwd": "../../backend"
    }
  },
  "environment": {
    "APP_DB_URL": "postgresql+asyncpg://postgres:master@localhost:5432/app_db",
    "RAG_DB_URL": "postgresql+asyncpg://postgres:master@localhost:5432/rag_db",
    "DEMO_MODE": "false",
    "LOG_LEVEL": "info",
    "CORS_ORIGINS": "http://localhost:5173"
  },
  "logging": {
    "maxBufferLines": 500,
    "noisePatterns": [
      "healthcheck",
      "GET /favicon",
      "HMR",
      "hmr update",
      "DeprecationWarning"
    ]
  },
  "launcherPort": 9001
}
