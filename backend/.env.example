# =============================================================================
# Backend Environment Variables
# =============================================================================
# Requirement levels: REQUIRED | OPTIONAL | CONDITIONAL
# REQUIRED = must be set for any mode
# OPTIONAL = has sensible defaults
# CONDITIONAL = needed only when specific features/providers are enabled

# =============================================================================
# REQUIRED — Core Application
# =============================================================================

# PostgreSQL connection string for application state (users, projects, conversations, etc.)
# Format: postgresql+asyncpg://user:password@host:port/database
APP_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

# Secret key for signing tokens and secure operations (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# =============================================================================
# OPTIONAL — Defaults Provided
# =============================================================================

# Run in demo mode with deterministic seed data (true | false)
# Default: true
DEMO_MODE=true

# Logging level (debug | info | warning | error | critical)
# Default: info
LOG_LEVEL=info

# Allowed CORS origins, comma-separated
# Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Application host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# CONDITIONAL — LLM Provider (REQUIRED when DEMO_MODE=false)
# =============================================================================

# Active text generation provider (azure_foundry | azure_openai | groq)
# REQUIRED in Live Mode
LLM_PROVIDER=azure_foundry

# --- Azure AI Foundry (CONDITIONAL: needed when LLM_PROVIDER=azure_foundry) ---
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.azure.com
AZURE_FOUNDRY_MODEL=

# --- Azure OpenAI (CONDITIONAL: needed when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Groq (CONDITIONAL: needed when LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# =============================================================================
# CONDITIONAL — RAG / Embeddings (REQUIRED when DEMO_MODE=false)
# =============================================================================

# PostgreSQL connection string for RAG database (documents, chunks, embeddings)
# Format: postgresql+asyncpg://user:password@host:port/database
RAG_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Embedding provider (azure_openai | azure_foundry | sentence_transformers)
EMBEDDING_PROVIDER=azure_openai

# Model name for embedding generation
EMBEDDING_MODEL=text-embedding-ada-002

# Vector dimension for embeddings (must match the model's output dimension)
EMBEDDING_DIMENSION=1536

# =============================================================================
# CONDITIONAL — External Data Sources
# =============================================================================

# MongoDB integration (CONDITIONAL: all MONGODB_* vars needed when MONGODB_ENABLED=true)
MONGODB_ENABLED=false
MONGODB_URL=mongodb://localhost:27017/external_db
